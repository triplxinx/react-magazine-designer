# Environment variables for Magazine Designer

# Default page DPI (dots per inch)
REACT_APP_DEFAULT_DPI=300

# Default page width in millimeters (e.g. A4: 210)
REACT_APP_DEFAULT_PAGE_WIDTH_MM=210

# Default page height in millimeters (e.g. A4: 297)
REACT_APP_DEFAULT_PAGE_HEIGHT_MM=297

# Default margin in millimeters
REACT_APP_DEFAULT_MARGIN_MM=10

# Allowed max upload image size in MB
REACT_APP_MAX_IMAGE_SIZE_MB=10
